{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Absolute number of residents aged 65 and over by Australian LGA, 2025.",

  "width": "container",
  "height": 540,

  "params": [
    {
      "name": "state_filter",
      "value": "All Australia",
      "bind": {
        "input": "select",
        "name": "Explore state: ",
        "options": [
          "All Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "Other Territories"
        ]
      }
    }
  ],

  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-134, 0, 0]
  },

  "layer": [
    {
      "data": {
        "url": "data/geo/lga_ageing_2025.topojson",
        "format": {
          "type": "topojson",
          "feature": "lga_2025"
        }
      },

      "transform": [
        {
          "lookup": "properties.LGA_CODE25",
          "from": {
            "data": {
              "url": "data/lga_65plus_points_2025.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "LGA_CODE25": "number"
                }
              }
            },
            "key": "LGA_CODE25",
            "fields": ["state"]
          }
        },
        {
          "filter": "state_filter === 'All Australia' || datum.state === state_filter"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#e8e3da",
        "stroke": "#f6f3ec",
        "strokeWidth": 0.5
      }
    },

    {
      "data": {
        "url": "data/lga_65plus_points_2025.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "age_65_plus": "number",
            "pct_65_plus": "number",
            "total_population": "number",
            "median_age": "number"
          }
        }
      },

      "transform": [
        {
          "filter": "state_filter === 'All Australia' || datum.state === state_filter"
        }
      ],

      "mark": {
        "type": "circle",
        "color": "#c9822d",
        "opacity": 0.58,
        "stroke": "#8a5721",
        "strokeWidth": 0.7
      },

      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },

        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },

        "size": {
          "field": "age_65_plus",
          "type": "quantitative",
          "title": "People aged 65+",

          "scale": {
            "domain": [0, 190000],
            "range": [8, 1450]
          },

          "legend": {
            "orient": "right",
            "titleColor": "#123d56",
            "labelColor": "#64727a",
            "titleFont": "DM Sans",
            "labelFont": "DM Sans",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "format": "~s",
            "values": [25000, 75000, 150000]
          }
        },

        "tooltip": [
          {
            "field": "lga_name",
            "type": "nominal",
            "title": "LGA"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "age_65_plus",
            "type": "quantitative",
            "title": "People aged 65+",
            "format": ","
          },
          {
            "field": "pct_65_plus",
            "type": "quantitative",
            "title": "65+ share",
            "format": ".1f"
          },
          {
            "field": "total_population",
            "type": "quantitative",
            "title": "Total population",
            "format": ","
          }
        ]
      }
    }
  ],

  "config": {
    "background": null,
    "font": "DM Sans",

    "view": {
      "stroke": null
    }
  }
}