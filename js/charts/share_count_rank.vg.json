
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Comparison of the share of residents aged 65 and over with the absolute number of older residents across Australian LGAs in 2025.",

  "width": "container",
  "height": 440,

  "data": {
    "url": "data/lga_ageing_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "total_population": "number",
        "pct_65_plus": "number",
        "age_65_plus": "number",
        "median_age": "number"
      }
    }
  },

  "transform": [
    {
      "filter": "datum.total_population >= 5000 && datum.age_65_plus > 0"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 55,
        "opacity": 0.55,
        "stroke": "#f6f3ec",
        "strokeWidth": 0.6
      },

      "encoding": {
        "x": {
          "field": "pct_65_plus",
          "type": "quantitative",
          "title": "Residents aged 65+ (%)",
          "scale": {
            "domain": [5, 45],
            "clamp": true
          },
          "axis": {
            "values": [10, 20, 30, 40],
            "labelExpr": "format(datum.value, '.0f') + '%'"
          }
        },

        "y": {
          "field": "age_65_plus",
          "type": "quantitative",
          "title": "Number of residents aged 65+ (log scale)",
          "scale": {
            "type": "log",
            "domain": [100, 200000],
            "clamp": true,
            "nice": false
          },
          "axis": {
            "values": [100, 1000, 10000, 100000],
            "format": "~s",
            "grid": true
          }
        },

        "color": {
          "condition": [
            {
              "test": "datum.lga_name === 'Victor Harbor'",
              "value": "#c9822d"
            },
            {
              "test": "datum.lga_name === 'Brisbane'",
              "value": "#123d56"
            }
          ],
          "value": "#1f7973"
        },

        "tooltip": [
          {
            "field": "lga_name",
            "type": "nominal",
            "title": "Local government area"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "pct_65_plus",
            "type": "quantitative",
            "title": "Residents aged 65+ (%)",
            "format": ".1f"
          },
          {
            "field": "age_65_plus",
            "type": "quantitative",
            "title": "Residents aged 65+",
            "format": ","
          },
          {
            "field": "total_population",
            "type": "quantitative",
            "title": "Total population",
            "format": ","
          },
          {
            "field": "median_age",
            "type": "quantitative",
            "title": "Median age",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.lga_name === 'Victor Harbor' || datum.lga_name === 'Brisbane'"
        }
      ],

      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontSize": 12,
        "fontWeight": 700,
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "dy": -8,
        "color": "#123d56"
      },

      "encoding": {
        "x": {
          "field": "pct_65_plus",
          "type": "quantitative",
          "scale": {
            "domain": [5, 45],
            "clamp": true
          }
        },

        "y": {
          "field": "age_65_plus",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "domain": [100, 200000],
            "clamp": true,
            "nice": false
          }
        },

        "text": {
          "field": "lga_name",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "background": null,
    "font": "DM Sans",

    "axis": {
      "labelColor": "#64727a",
      "titleColor": "#123d56",
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "gridColor": "#d9d4ca",
      "gridOpacity": 0.7,
      "domain": false,
      "ticks": false,
      "labelPadding": 6
    },

    "view": {
      "stroke": null
    }
  }
}
