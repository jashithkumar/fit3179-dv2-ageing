{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Australia's population age structure in 1971 and 2025.",

  "data": {
    "url": "data/australia_population_pyramid_1971_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "population": "number",
        "population_signed": "number"
      }
    }
  },

  "facet": {
    "column": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "header": {
        "labelFont": "DM Sans",
        "labelFontSize": 16,
        "labelFontWeight": 700,
        "labelColor": "#173b57",
        "labelPadding": 14
      }
    }
  },

  "spec": {
    "width": 360,
    "height": 430,

    "mark": {
      "type": "bar"
    },

    "encoding": {
      "y": {
        "field": "age_group",
        "type": "ordinal",
        "title": null,
        "sort": [
          "85+",
          "80–84",
          "75–79",
          "70–74",
          "65–69",
          "60–64",
          "55–59",
          "50–54",
          "45–49",
          "40–44",
          "35–39",
          "30–34",
          "25–29",
          "20–24",
          "15–19",
          "10–14",
          "5–9",
          "0–4"
        ],
        "axis": {
          "domain": false,
          "ticks": false,
          "labelColor": "#68757d",
          "labelFontSize": 11
        }
      },

      "x": {
        "field": "population_signed",
        "type": "quantitative",
        "title": "Population",
        "scale": {
          "domain": [-1800000, 1800000]
        },
        "axis": {
          "gridColor": "#e4dfd5",
          "gridOpacity": 0.8,
          "domain": false,
          "labelColor": "#68757d",
          "titleColor": "#68757d",
          "labelExpr": "format(abs(datum.value), '~s')"
        }
      },

      "color": {
        "field": "sex",
        "type": "nominal",
        "title": null,
        "scale": {
          "domain": ["Male", "Female"],
          "range": ["#54799b", "#9b6f91"]
        },
        "legend": {
          "orient": "top",
          "direction": "horizontal",
          "labelColor": "#68757d",
          "labelFontSize": 12
        }
      },

      "tooltip": [
        {
          "field": "year",
          "type": "quantitative",
          "title": "Year",
          "format": "d"
        },
        {
          "field": "age_group",
          "type": "ordinal",
          "title": "Age group"
        },
        {
          "field": "sex",
          "type": "nominal",
          "title": "Sex"
        },
        {
          "field": "population",
          "type": "quantitative",
          "title": "Population",
          "format": ","
        }
      ]
    }
  },

  "config": {
    "background": null,
    "font": "DM Sans",
    "view": {
      "stroke": null
    }
  }
}