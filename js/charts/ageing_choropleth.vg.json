{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Share of population aged 65 and over by Australian LGA, 2025.",

  "width": "container",
  "height": 540,

  "data": {
    "url": "data/geo/lga_ageing_2025.topojson",
    "format": {
      "type": "topojson",
      "feature": "lga_2025"
    }
  },

  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-134, 0, 0],
    "center": [0, -28]
  },

  "mark": {
    "type": "geoshape",
    "stroke": "#f5f2e9",
    "strokeWidth": 0.4
  },

  "encoding": {

    "color": {
      "field": "properties.pct_65_plus",
      "type": "quantitative",

      "title": "65+ (%)",

      "scale": {
        "domain": [5, 45],
        "range": [
          "#e5f0ee",
          "#c6dfdc",
          "#98c7c2",
          "#64aaa4",
          "#348780",
          "#174f4d"
        ]
      },

      "legend": {
        "orient": "right",
        "gradientLength": 210,
        "gradientThickness": 12,

        "titleColor": "#173b57",
        "labelColor": "#68757d",

        "titleFontSize": 12,
        "labelFontSize": 11,

        "format": ".0f"
      }
    },

    "tooltip": [
      {
        "field": "properties.lga_name",
        "type": "nominal",
        "title": "LGA"
      },
      {
        "field": "properties.state",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "properties.pct_65_plus",
        "type": "quantitative",
        "title": "Aged 65+",
        "format": ".1f"
      },
      {
        "field": "properties.age_65_plus",
        "type": "quantitative",
        "title": "People aged 65+",
        "format": ","
      },
      {
        "field": "properties.median_age",
        "type": "quantitative",
        "title": "Median age",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "background": null,

    "font": "DM Sans",

    "view": {
      "stroke": null
    }
  }
}