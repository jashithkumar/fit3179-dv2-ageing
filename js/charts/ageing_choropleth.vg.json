{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Share of population aged 65 and over by Australian LGA, 2025.",

  "width": "container",
  "height": 540,

  "data": {
    "url": "data/geo/lga_ageing_2025.topojson",
    "format": {
      "type": "topojson",
      "feature": "lga_2025"
    }
  },

  "params": [
    {
      "name": "state_filter",
      "value": "All Australia",
      "bind": {
        "input": "select",
        "name": "Explore state: ",
        "options": [
          "All Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "Other Territories"
        ]
      }
    }
  ],

  "transform": [
    {
      "filter": "state_filter === 'All Australia' || datum.properties.state === state_filter"
    }
  ],

  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-134, 0, 0]
  },

  "mark": {
    "type": "geoshape",
    "stroke": "#f6f3ec",
    "strokeWidth": 0.55
  },

  "encoding": {
    "color": {
      "field": "properties.pct_65_plus",
      "type": "quantitative",

      "title": "Share aged 65+ (%)",

      "scale": {
        "domain": [5, 45],
        "clamp": true,
        "range": [
          "#c7dedb",
          "#a9ceca",
          "#82b9b4",
          "#58a19b",
          "#337f7a",
          "#174f4d"
        ]
      },

      "legend": {
        "orient": "right",
        "gradientLength": 210,
        "gradientThickness": 12,

        "titleColor": "#123d56",
        "labelColor": "#64727a",

        "titleFont": "DM Sans",
        "labelFont": "DM Sans",

        "titleFontSize": 12,
        "labelFontSize": 11,

        "format": ".0f"
      }
    },

    "tooltip": [
      {
        "field": "properties.lga_name",
        "type": "nominal",
        "title": "LGA"
      },
      {
        "field": "properties.state",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "properties.pct_65_plus",
        "type": "quantitative",
        "title": "Aged 65+",
        "format": ".1f"
      },
      {
        "field": "properties.age_65_plus",
        "type": "quantitative",
        "title": "People aged 65+",
        "format": ","
      },
      {
        "field": "properties.median_age",
        "type": "quantitative",
        "title": "Median age",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "background": null,

    "font": "DM Sans",

    "view": {
      "stroke": null
    }
  }
}