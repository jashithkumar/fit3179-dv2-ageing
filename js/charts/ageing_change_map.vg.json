{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Change in the share of population aged 65 and over by Australian LGA from 2001 to 2025.",
  "width": "container",
  "height": 540,

  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-134, 0, 0],
    "center": [0, -28]
  },

  "layer": [
    {
      "data": {
        "url": "data/geo/lga_ageing_change_2001_2025.topojson",
        "format": {
          "type": "topojson",
          "feature": "lga_2025"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#d9d6ce",
        "stroke": "#f5f2e9",
        "strokeWidth": 0.45
      }
    },

    {
      "data": {
        "url": "data/geo/lga_ageing_change_2001_2025.topojson",
        "format": {
          "type": "topojson",
          "feature": "lga_2025"
        }
      },

      "transform": [
        {
          "filter": "isValid(datum.properties.pp_change_65_plus)"
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#f5f2e9",
        "strokeWidth": 0.45
      },

      "encoding": {
        "color": {
          "field": "properties.pp_change_65_plus",
          "type": "quantitative",
          "title": "Change (pp)",

          "scale": {
            "domain": [-5, 0, 20],
            "range": [
              "#6672a5",
              "#f1eee6",
              "#c7773c"
            ]
          },

          "legend": {
            "orient": "right",
            "gradientLength": 210,
            "gradientThickness": 12,
            "titleColor": "#173b57",
            "labelColor": "#68757d",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "format": "+.0f"
          }
        },

        "tooltip": [
          {
            "field": "properties.lga_name",
            "type": "nominal",
            "title": "LGA"
          },
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "properties.pct_65_plus_2001",
            "type": "quantitative",
            "title": "65+ share, 2001",
            "format": ".1f"
          },
          {
            "field": "properties.pct_65_plus_2025",
            "type": "quantitative",
            "title": "65+ share, 2025",
            "format": ".1f"
          },
          {
            "field": "properties.pp_change_65_plus",
            "type": "quantitative",
            "title": "Change (pp)",
            "format": "+.1f"
          }
        ]
      }
    }
  ],

  "config": {
    "background": null,
    "font": "DM Sans",
    "view": {
      "stroke": null
    }
  }
}