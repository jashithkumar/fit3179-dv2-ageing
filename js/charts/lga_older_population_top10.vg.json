{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "data": {
    "url": "data/lga_ageing_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "total_population": "number",
        "age_65_plus": "number",
        "age_75_plus": "number",
        "age_85_plus": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.total_population >= 5000 && datum.age_65_plus > 0"
    },
    {
      "calculate": "datum.age_65_plus - datum.age_75_plus",
      "as": "age_65_74"
    },
    {
      "calculate": "datum.age_75_plus - datum.age_85_plus",
      "as": "age_75_84"
    },
    {
      "calculate": "datum.age_85_plus",
      "as": "age_85"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "age_65_plus",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.rank <= 10"
    },
    {
      "calculate": "datum.lga_name + ' (' + format(datum.age_65_plus, ',') + ')'",
      "as": "lga_label"
    },
    {
      "fold": [
        "age_65_74",
        "age_75_84",
        "age_85"
      ],
      "as": [
        "age_band",
        "age_count"
      ]
    },
    {
      "calculate": "datum.age_count / datum.age_65_plus * 100",
      "as": "share"
    },
    {
      "calculate": "datum.age_band === 'age_65_74' ? '65–74' : datum.age_band === 'age_75_84' ? '75–84' : '85+'",
      "as": "age_band_label"
    },
    {
      "calculate": "format(datum.share, '.1f') + '%'",
      "as": "share_label"
    }
  ],
  "width": {
    "step": 280
  },
  "height": {
    "step": 34
  },
  "encoding": {
    "x": {
      "field": "age_band_label",
      "type": "ordinal",
      "sort": [
        "65–74",
        "75–84",
        "85+"
      ],
      "axis": {
        "orient": "top",
        "title": null,
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelPadding": 10,
        "ticks": false,
        "domain": false
      }
    },
    "y": {
      "field": "lga_label",
      "type": "ordinal",
      "sort": {
        "field": "age_65_plus",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelFontSize": 11,
        "labelPadding": 8,
        "labelLimit": 230,
        "ticks": false,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 4,
        "stroke": "#ffffff",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "share",
          "type": "quantitative",
          "scale": {
            "domain": [0, 60],
            "scheme": "tealblues"
          },
          "legend": {
            "title": "Share of 65+ residents (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 300,
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "lga_name",
            "type": "nominal",
            "title": "LGA"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "age_65_plus",
            "type": "quantitative",
            "title": "Residents aged 65+",
            "format": ","
          },
          {
            "field": "age_band_label",
            "type": "nominal",
            "title": "Age group"
          },
          {
            "field": "age_count",
            "type": "quantitative",
            "title": "Residents in age group",
            "format": ","
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of 65+ population (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "share_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.share >= 40",
            "value": "#ffffff"
          },
          "value": "#173d3a"
        }
      }
    }
  ],
  "config": {
  "background": "transparent",
  "view": {
    "stroke": null,
    "fill": null
  },
  "axis": {
    "labelFont": "DM Sans",
    "titleFont": "DM Sans"
  },
  "legend": {
    "labelFont": "DM Sans",
    "titleFont": "DM Sans"
  }
}
}
