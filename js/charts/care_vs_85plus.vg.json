
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Comparison of each state's share of Australia's population aged 85+ and share of residential-care users by service location, 2025.",

  "width": "container",
  "height": 330,

  "data": {
    "url": "data/state_care_vs_85plus_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "age_85_plus_population": "number",
        "age_85_plus_share_pct": "number",
        "residential_care_users_service_location": "number",
        "residential_care_share_pct": "number",
        "difference_pp": "number"
      }
    }
  },

  "transform": [
    {
      "fold": [
        "age_85_plus_share_pct",
        "residential_care_share_pct"
      ],
      "as": ["measure", "share_pct"]
    },
    {
      "calculate": "datum.measure === 'age_85_plus_share_pct' ? 'Share of 85+ population' : 'Share of residential-care users'",
      "as": "measure_label"
    },
    {
      "calculate": "datum.measure === 'age_85_plus_share_pct' ? datum.age_85_plus_population : datum.residential_care_users_service_location",
      "as": "count"
    },
    {
      "calculate": "datum.state === 'New South Wales' ? 'NSW' : datum.state === 'Victoria' ? 'VIC' : datum.state === 'Queensland' ? 'QLD' : datum.state === 'Western Australia' ? 'WA' : datum.state === 'South Australia' ? 'SA' : datum.state === 'Tasmania' ? 'TAS' : datum.state === 'Northern Territory' ? 'NT' : datum.state === 'Australian Capital Territory' ? 'ACT' : 'Other'",
      "as": "state_short"
    }
  ],

  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 2
  },

  "encoding": {
    "x": {
      "field": "state_short",
      "type": "nominal",
      "title": null,
      "sort": [
        "NSW",
        "VIC",
        "QLD",
        "WA",
        "SA",
        "TAS",
        "NT",
        "ACT",
        "Other"
      ],
      "axis": {
        "labelAngle": 0,
        "labelColor": "#64727a",
        "labelFontSize": 11,
        "labelPadding": 8,
        "ticks": false,
        "domain": false
      }
    },

    "xOffset": {
      "field": "measure_label",
      "type": "nominal",
      "sort": [
        "Share of 85+ population",
        "Share of residential-care users"
      ]
    },

    "y": {
      "field": "share_pct",
      "type": "quantitative",
      "title": "Share of national total (%)",
      "scale": {
        "domain": [0, 40],
        "nice": false
      },
      "axis": {
        "values": [0, 10, 20, 30, 40],
        "labelExpr": "format(datum.value, '.0f') + '%'",
        "labelColor": "#64727a",
        "titleColor": "#173b57",
        "gridColor": "#d9d4ca",
        "gridOpacity": 0.8,
        "domain": false,
        "ticks": false
      }
    },

    "color": {
      "field": "measure_label",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Share of 85+ population",
          "Share of residential-care users"
        ],
        "range": [
          "#1f7973",
          "#c9822d"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "labelColor": "#64727a",
        "labelFontSize": 11,
        "symbolType": "square",
        "symbolSize": 100,
        "offset": 8
      }
    },

    "tooltip": [
      {
        "field": "state",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "measure_label",
        "type": "nominal",
        "title": "Measure"
      },
      {
        "field": "share_pct",
        "type": "quantitative",
        "title": "Share of national total",
        "format": ".2f",
        "formatType": "number"
      },
      {
        "field": "count",
        "type": "quantitative",
        "title": "People",
        "format": ",.0f"
      }
    ]
  },

  "config": {
    "background": null,
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "titleFontSize": 11,
      "titleFontWeight": 600
    }
  }
}
